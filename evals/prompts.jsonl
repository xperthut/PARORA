# PARORA agent eval cases — format documented at the top of evals/run.py.
# source "log" = phrasing taken from logs/parora.log (real sessions);
# "synthetic" = paraphrase or gap filler. Keep ids stable: reports diff by id.
#
# ── lookup: one request, one tool ────────────────────────────────────────────
{"id": "load-1crn", "category": "lookup", "groups": ["load"], "source": "log", "turns": ["load 1CRN"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1crn"}, "ok": true}], "forbid": ["show", "show_all", "color", "set_transparency"], "ask": false, "max_calls": 1}}
{"id": "load-pdb-4hhb", "category": "lookup", "groups": ["load"], "source": "log", "turns": ["load PDB 4HHB"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "4hhb"}, "ok": true}], "ask": false}}
{"id": "load-protein-by-name", "category": "lookup", "groups": ["lookup", "load"], "source": "log", "requires": ["network"], "turns": ["load hemoglobin"], "expect": {"tools": [{"name": "load_protein", "args": {"name": "hemoglobin"}}], "forbid": ["fetch_structure"]}}
{"id": "find-structures-tp53", "category": "lookup", "groups": ["lookup"], "source": "synthetic", "requires": ["network"], "turns": ["what structures are there for TP53"], "expect": {"tools": [{"name": "find_protein|protein_structures"}], "forbid": ["load_protein", "fetch_structure", "add_structure"]}}
{"id": "function-tp53", "category": "lookup", "groups": ["lookup"], "source": "log", "requires": ["network"], "turns": ["what does TP53 do"], "expect": {"tools": [{"name": "protein_function"}]}}
{"id": "highlight-res5", "category": "lookup", "groups": ["style"], "source": "log", "preload": ["1CRN"], "turns": ["highlight residue 5"], "expect": {"tools": [{"any": [{"name": "highlight", "args": {"target": "\\b5\\b"}}, {"name": "select", "args": {"expression": "\\b5\\b"}}]}], "ask": false}}
{"id": "color-chain-a-red", "category": "lookup", "groups": ["style"], "source": "log", "preload": ["4HHB"], "turns": ["color chain A red"], "expect": {"tools": [{"name": "color", "args": {"color": "red", "selection": "\\bA\\b|chain ?a"}}], "forbid": ["hide", "hide_all"]}}
{"id": "show-cartoon-chain-a", "category": "lookup", "groups": ["style"], "source": "log", "preload": ["4HHB"], "turns": ["show cartoon of chain A"], "expect": {"tools": [{"name": "show", "args": {"rep_type": "cartoon", "selection": "\\bA\\b|chain ?a"}}]}}
{"id": "show-surface", "category": "lookup", "groups": ["style"], "source": "log", "preload": ["1CRN"], "turns": ["display the protein as surface"], "expect": {"tools": [{"name": "show|show_all", "args": {"rep_type": "surface"}}]}}
{"id": "set-background", "category": "lookup", "groups": ["style"], "source": "synthetic", "preload": ["1CRN"], "turns": ["set the background to white"], "expect": {"tools": [{"name": "set_background", "args": {"color": "white"}}], "max_calls": 1}}
{"id": "zoom-heme", "category": "lookup", "groups": ["style"], "source": "synthetic", "preload": ["4HHB"], "turns": ["zoom in on the heme in chain B"], "expect": {"tools": [{"name": "zoom", "args": {"selection": "hem"}}]}}
{"id": "transparency-chain-c", "category": "lookup", "groups": ["style"], "source": "synthetic", "preload": ["4HHB"], "turns": ["make chain C 50% transparent"], "expect": {"tools": [{"name": "set_transparency", "args": {"value": "0?\\.5|50", "selection": "\\bC\\b|chain ?c"}}]}}
{"id": "describe-ligands", "category": "lookup", "groups": ["describe"], "source": "log", "preload": ["4HHB"], "turns": ["what ligands are in this structure?"], "expect": {"say": ["\\bHEM\\b|heme|haem"], "forbid": ["fetch_structure", "add_structure", "load_protein"]}}
{"id": "count-chains", "category": "lookup", "groups": ["describe"], "source": "log", "preload": ["4HHB"], "turns": ["how many chains are there?"], "expect": {"say": ["\\b4\\b|four"], "forbid": ["fetch_structure", "load_protein"]}}
{"id": "list-residues", "category": "lookup", "groups": ["describe"], "source": "synthetic", "preload": ["1CRN"], "turns": ["list the residues in chain A"], "expect": {"tools": [{"name": "list_residues"}]}}
{"id": "bfactor-summary", "category": "lookup", "groups": ["describe"], "source": "synthetic", "preload": ["1UBQ"], "turns": ["summarize the B-factors"], "expect": {"tools": [{"name": "bfactor_summary", "ok": true}]}}
{"id": "select-by-bfactor", "category": "lookup", "groups": ["style"], "source": "synthetic", "preload": ["1UBQ"], "turns": ["select the residues with a B-factor above 30"], "expect": {"tools": [{"name": "select_by_bfactor", "args": {"operator": ">|above|gt", "threshold": "^30"}}]}}
{"id": "distance-plain", "category": "lookup", "groups": ["measure"], "source": "synthetic", "preload": ["1CRN"], "turns": ["how far apart are residues 10 and 40"], "expect": {"tools": [{"name": "measure_distance|measure_mda_distance", "ok": true}], "say": ["Å|angstrom"]}}
{"id": "distance-spec", "category": "lookup", "groups": ["measure"], "source": "log", "preload": ["4HHB"], "turns": ["distance between A/58 and A/87"], "expect": {"tools": [{"name": "measure_distance|measure_mda_distance", "ok": true}], "say": ["Å|angstrom"]}}
{"id": "distance-mda-syntax", "category": "lookup", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["measure the distance between sel1='resid 5 and name CA' and sel2='resid 10 and name CA'"], "expect": {"tools": [{"name": "measure_mda_distance", "args": {"sel1": "resid 5", "sel2": "resid 10"}, "ok": true}]}}
{"id": "angle-three", "category": "lookup", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["measure the angle formed by the CA atoms of residues 5, 10, and 15 in chain A"], "expect": {"tools": [{"name": "measure_angle|measure_mda_angle", "ok": true}], "ask": false}}
{"id": "dihedral-four", "category": "lookup", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["measure the dihedral angle through residues 5, 6, 7 and 8"], "expect": {"tools": [{"name": "measure_dihedral|measure_mda_dihedral", "ok": true}], "ask": false}}
{"id": "salt-bridges-chain-a", "category": "lookup", "groups": ["interact"], "source": "log", "preload": ["4HHB"], "turns": ["detect salt bridges in chain A"], "expect": {"tools": [{"name": "detect_salt_bridges", "args": {"chain": "^A$"}, "ok": true}]}}
{"id": "salt-bridges-whole", "category": "lookup", "groups": ["interact"], "source": "synthetic", "preload": ["4HHB"], "turns": ["are there any salt bridges in this structure"], "expect": {"tools": [{"name": "detect_salt_bridges|find_interactions", "ok": true}]}}
{"id": "hbonds-no-reload", "category": "lookup", "groups": ["interact"], "source": "log", "preload": ["1CRN"], "turns": ["search for hydrogen bonds"], "expect": {"tools": [{"name": "detect_hydrogen_bonds|find_interactions", "ok": true}], "forbid": ["fetch_structure", "add_structure", "load_protein", "find_protein"]}}
{"id": "contacts-heme", "category": "lookup", "groups": ["measure", "interact"], "source": "synthetic", "preload": ["4HHB"], "turns": ["what residues surround the heme"], "expect": {"tools": [{"name": "find_contacts|nearby_residues|detect_contacts|find_interactions", "ok": true}], "forbid": ["find_pockets"]}}
{"id": "disulfides-crambin", "category": "lookup", "groups": ["interact"], "source": "synthetic", "preload": ["1CRN"], "turns": ["find the disulfide bonds"], "expect": {"tools": [{"name": "find_interactions|detect_contacts", "ok": true}], "say": ["\\b3\\b|three"]}}
{"id": "pockets", "category": "lookup", "groups": ["pocket"], "source": "synthetic", "requires": ["fpocket"], "preload": ["4HHB"], "turns": ["find the binding pockets"], "expect": {"tools": [{"name": "find_pockets", "ok": true}], "forbid": ["hide", "hide_all"]}}
{"id": "what-fold", "category": "lookup", "groups": ["fold"], "source": "log", "requires": ["network"], "preload": ["1UBQ"], "turns": ["what fold is this"], "expect": {"tools": [{"name": "describe_fold"}], "not_say": ["cannot be determined from a single static"]}}
{"id": "structural-neighbours", "category": "lookup", "groups": ["fold"], "source": "log", "requires": ["foldseek"], "preload": ["1UBQ"], "turns": ["what known structures is this similar to"], "expect": {"tools": [{"name": "find_structural_neighbors"}], "forbid": ["download_foldseek_database"]}}
{"id": "mutation-k48r", "category": "lookup", "groups": ["mutation"], "source": "synthetic", "requires": ["esm"], "preload": ["1UBQ"], "turns": ["is K48R tolerated"], "expect": {"tools": [{"name": "predict_mutation_effect", "args": {"residue": "48"}, "ok": true}], "say": ["predict|model"]}}
{"id": "render-image", "category": "lookup", "groups": ["style"], "source": "synthetic", "requires": ["pymol"], "preload": ["1CRN"], "turns": ["render a ray-traced image of this"], "expect": {"tools": [{"name": "render_image", "ok": true}]}}
{"id": "add-label", "category": "lookup", "groups": ["label"], "source": "synthetic", "preload": ["4HHB"], "turns": ["label chain A as alpha subunit"], "expect": {"tools": [{"name": "add_label", "args": {"text": "alpha", "target": "\\bA\\b|chain ?a"}}]}}
{"id": "list-labels", "category": "lookup", "groups": ["label"], "source": "synthetic", "preload": ["4HHB", {"tool": "add_label", "args": {"text": "alpha 1", "target": "A"}}], "turns": ["what labels are on the structure?"], "expect": {"say": ["alpha 1"]}}
{"id": "orient-membrane", "category": "lookup", "groups": ["membrane"], "source": "synthetic", "requires": ["network"], "preload": ["1CRN"], "turns": ["orient this protein in the membrane using OPM"], "expect": {"tools": [{"name": "orient_membrane"}]}}
{"id": "membrane-status", "category": "lookup", "groups": ["membrane"], "source": "synthetic", "preload": ["1CRN"], "turns": ["is the membrane build finished?"], "expect": {"tools": [{"name": "membrane_status"}], "forbid": ["build_membrane"]}}
{"id": "inspect-prep", "category": "lookup", "groups": ["prepare"], "source": "synthetic", "preload": ["4HHB"], "turns": ["is this structure ready for simulation?"], "expect": {"tools": [{"name": "inspect_preparation", "ok": true}], "forbid": ["prepare_structure", "remove_solvent", "save_structure"]}}
{"id": "prepare-amber", "category": "lookup", "groups": ["prepare"], "source": "synthetic", "preload": ["1CRN"], "turns": ["prepare this structure for Amber"], "expect": {"tools": [{"name": "prepare_structure"}]}}
{"id": "superpose-two", "category": "lookup", "groups": ["superpose"], "source": "synthetic", "preload": ["4HHB", "2W72"], "turns": ["superpose 2W72 onto 4HHB and report the RMSD"], "expect": {"tools": [{"name": "superpose_structures", "args": {"mobile": "2w72", "reference": "4hhb"}, "ok": true}], "say": ["rmsd"]}}
{"id": "add-second-structure", "category": "lookup", "groups": ["load"], "source": "synthetic", "preload": ["1CRN"], "turns": ["also load 1UBQ"], "expect": {"tools": [{"name": "add_structure|fetch_structure", "args": {"pdb_id": "1ubq"}, "ok": true}], "forbid": ["clear_scene", "replace_scene", "remove_structure"]}}
{"id": "which-loaded", "category": "lookup", "groups": ["describe"], "source": "log", "preload": ["1CRN", "1UBQ"], "turns": ["which structures are loaded?"], "expect": {"say": ["1CRN", "1UBQ"], "forbid": ["fetch_structure", "add_structure", "clear_scene"]}}
{"id": "remove-structure", "category": "lookup", "groups": ["load"], "source": "synthetic", "preload": ["1CRN", "1UBQ"], "turns": ["remove 1UBQ from the scene"], "expect": {"tools": [{"name": "remove_structure", "args": {"target": "1ubq"}}], "forbid": ["clear_scene", "hide_all"]}}
{"id": "xray-with-ligand", "category": "lookup", "groups": ["lookup"], "source": "log", "requires": ["network"], "turns": ["list the X-ray structures of HER2 with a ligand"], "expect": {"tools": [{"name": "protein_structures|find_protein"}], "forbid": ["load_protein", "fetch_structure"]}}
#
# ── multistep: one request, several tools ────────────────────────────────────
{"id": "load-strip-cartoon", "category": "multistep", "groups": ["load", "prepare", "style"], "source": "log", "turns": ["load 1CRN, remove solvent, then show cartoon colored by chain"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1crn"}}, {"name": "remove_solvent"}, {"name": "show|show_all", "args": {"rep_type": "cartoon"}}], "ordered": true}}
{"id": "load-summarize-show", "category": "multistep", "groups": ["load", "describe", "style"], "source": "log", "turns": ["load PDB 4HHB, summarize its chains, and show chain B as ball and stick"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "4hhb"}}, {"name": "summarize_chains|describe_structure"}, {"any": [{"name": "show", "args": {"selection": "\\bB\\b|chain ?b"}}, {"name": "highlight", "args": {"target": "\\bB\\b|chain ?b"}}]}], "ordered": true}}
{"id": "cartoon-plus-highlight", "category": "multistep", "groups": ["style"], "source": "log", "preload": ["1CRN"], "turns": ["show cartoon and highlight residue 10"], "expect": {"tools": [{"name": "show|show_all", "args": {"rep_type": "cartoon"}}, {"any": [{"name": "highlight", "args": {"target": "\\b10\\b"}}, {"name": "select", "args": {"expression": "\\b10\\b"}}, {"name": "show", "args": {"selection": "\\b10\\b"}}]}]}}
{"id": "three-colors", "category": "multistep", "groups": ["style"], "source": "log", "preload": ["4HHB"], "turns": ["make chain A in red color, chain B in blue color and rest in gray color."], "expect": {"tools": [{"name": "color", "args": {"color": "red", "selection": "\\bA\\b|chain ?a"}}, {"name": "color", "args": {"color": "blue", "selection": "\\bB\\b|chain ?b"}}, {"name": "color", "args": {"color": "gr[ae]y"}}], "forbid": ["hide", "hide_all"]}}
{"id": "fetch-show-zoom-k48", "category": "multistep", "groups": ["load", "style"], "source": "synthetic", "turns": ["fetch ubiquitin 1UBQ, show lysine 48 as sticks and zoom to it"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1ubq"}}, {"any": [{"name": "show", "args": {"selection": "48"}}, {"name": "highlight", "args": {"target": "48"}}, {"name": "select", "args": {"expression": "48"}}]}, {"name": "zoom", "args": {"selection": "48"}}], "ordered": true}}
{"id": "saltbridge-and-hbonds", "category": "multistep", "groups": ["interact"], "source": "synthetic", "preload": ["4HHB"], "turns": ["find the salt bridges and the hydrogen bonds between chain A and chain B"], "expect": {"tools": [{"name": "detect_salt_bridges|find_interactions", "ok": true}, {"name": "detect_hydrogen_bonds|find_interactions", "ok": true}]}}
{"id": "contacts-then-highlight", "category": "multistep", "groups": ["measure", "style"], "source": "synthetic", "preload": ["4HHB"], "turns": ["find residues within 4 Å of the heme in chain A and highlight them"], "expect": {"tools": [{"name": "find_contacts|nearby_residues|detect_contacts|select_within", "ok": true}, {"name": "highlight|select|select_within|show"}]}}
{"id": "load-and-superpose", "category": "multistep", "groups": ["load", "superpose"], "source": "synthetic", "preload": ["4HHB"], "turns": ["load 2W72 and superpose it on 4HHB"], "expect": {"tools": [{"name": "add_structure|fetch_structure", "args": {"pdb_id": "2w72"}}, {"name": "superpose_structures", "ok": true}], "ordered": true, "forbid": ["clear_scene", "replace_scene", "remove_structure"]}}
{"id": "strip-and-save", "category": "multistep", "groups": ["prepare"], "source": "synthetic", "preload": ["1CRN"], "turns": ["remove the water and save the result as crambin_dry.pdb"], "expect": {"tools": [{"name": "remove_solvent"}, {"name": "save_structure", "args": {"filename": "crambin_dry"}}], "ordered": true}}
{"id": "load-protein-and-function", "category": "multistep", "groups": ["lookup", "load"], "source": "synthetic", "requires": ["network"], "turns": ["load the human insulin receptor and tell me what it does"], "expect": {"tools": [{"name": "load_protein", "args": {"name": "insulin"}}, {"name": "protein_function"}]}}
{"id": "pocket-then-contacts", "category": "multistep", "groups": ["pocket", "measure"], "source": "synthetic", "requires": ["fpocket"], "preload": ["4HHB"], "turns": ["find the pockets, then list the residues lining pocket 1"], "expect": {"tools": [{"name": "find_pockets", "ok": true}], "not_say": ["cannot find pocket"]}}
#
# ── ambiguity: must ask, not guess ───────────────────────────────────────────
{"id": "angle-two-residues", "category": "ambiguity", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["measure the angle between residues 20 and 30"], "expect": {"ask": true, "forbid": ["measure_angle", "measure_mda_angle"]}}
{"id": "angle-two-paraphrase", "category": "ambiguity", "groups": ["measure"], "source": "synthetic", "preload": ["1CRN"], "turns": ["what's the angle made by residues 12 and 40"], "expect": {"ask": true, "forbid": ["measure_angle", "measure_mda_angle"]}}
{"id": "angle-one-residue", "category": "ambiguity", "groups": ["measure"], "source": "synthetic", "preload": ["4HHB"], "turns": ["measure the angle at residue 88"], "expect": {"ask": true, "forbid": ["measure_angle", "measure_mda_angle"]}}
{"id": "dihedral-two-residues", "category": "ambiguity", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["measure the dihedral between residues 5 and 8"], "expect": {"say": ["four"], "forbid": ["measure_dihedral", "measure_mda_dihedral"]}}
{"id": "ca-angle-no-chain", "category": "ambiguity", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["highlight the CA atoms of residues 5, 10, and 15 and measure the angle they form"], "expect": {"say": ["chain"], "forbid": ["measure_angle", "measure_mda_angle"]}}
{"id": "compare-one-loaded", "category": "ambiguity", "groups": ["superpose"], "source": "log", "preload": ["1CRN"], "turns": ["compare it"], "expect": {"ask": true, "forbid": ["superpose_structures", "align_structures"]}}
{"id": "rmsd-one-loaded", "category": "ambiguity", "groups": ["superpose"], "source": "log", "preload": ["4HHB"], "turns": ["what is the RMSD?"], "expect": {"ask": true, "forbid": ["superpose_structures", "align_structures"], "not_say": ["rmsd (is|of) \\d"]}}
{"id": "highlight-the-domain", "category": "ambiguity", "groups": ["style"], "source": "log", "preload": ["7MN5"], "turns": ["highlight the domain"], "expect": {"ask": true}}
{"id": "generic-ligand-two-hets", "category": "ambiguity", "groups": ["measure", "interact"], "source": "log", "preload": ["4HHB"], "turns": ["get the contacts for the ligand"], "expect": {"ask": true, "say": ["HEM|heme"]}}
{"id": "load-chain-nothing-loaded", "category": "ambiguity", "groups": ["load"], "source": "log", "turns": ["load chain A"], "expect": {"ask": true, "forbid": ["fetch_structure", "add_structure", "load_protein"]}}
{"id": "spike-ambiguous-name", "category": "ambiguity", "groups": ["lookup", "load"], "source": "log", "requires": ["network"], "turns": ["load spike protein"], "expect": {"ask": true, "not_say": ["moesin (is|has been) loaded"]}}
{"id": "other-chains-her2", "category": "ambiguity", "groups": ["lookup"], "source": "log", "requires": ["network"], "preload": [{"tool": "load_protein", "args": {"name": "HER2"}}], "turns": ["what are the other chains available for this protein?"], "expect": {"ask": true}}
{"id": "distance-no-referent", "category": "ambiguity", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["what is their distance"], "expect": {"ask": true, "forbid": ["measure_distance", "measure_mda_distance"]}}
{"id": "mutate-no-residue", "category": "ambiguity", "groups": ["mutation"], "source": "synthetic", "preload": ["1UBQ"], "turns": ["what happens if I mutate it to alanine"], "expect": {"ask": true, "forbid": ["predict_mutation_effect"]}}
#
# ── destructive: near-misses must not hide/clear/write; real asks must ──────
{"id": "hidden-pocket-no-hide", "category": "destructive", "groups": ["pocket"], "source": "log", "preload": ["4HHB"], "turns": ["find the hidden binding pocket"], "expect": {"tools": [{"name": "find_pockets"}], "forbid": ["hide", "hide_all", "clear_scene"]}}
{"id": "without-water-hypothetical", "category": "destructive", "groups": ["prepare"], "source": "log", "preload": ["1CRN"], "turns": ["what would this structure look like without water"], "expect": {"forbid": ["save_structure", "remove_solvent", "clear_scene", "hide_all"]}}
{"id": "hide-everything", "category": "destructive", "groups": ["style"], "source": "log", "preload": ["1CRN"], "turns": ["hide everything"], "expect": {"tools": [{"name": "hide_all|hide"}], "forbid": ["clear_scene", "remove_structure"]}}
{"id": "clean-enough-question", "category": "destructive", "groups": ["prepare"], "source": "synthetic", "preload": ["1CRN"], "turns": ["is this structure clean enough to simulate?"], "expect": {"forbid": ["remove_solvent", "prepare_structure", "save_structure", "clear_scene", "hide", "hide_all"]}}
{"id": "reset-colors", "category": "destructive", "groups": ["style"], "source": "synthetic", "preload": ["4HHB"], "turns": ["reset the colors to default"], "expect": {"forbid": ["clear_scene", "remove_structure", "hide_all", "hide"]}}
{"id": "remove-labels", "category": "destructive", "groups": ["label"], "source": "synthetic", "preload": ["4HHB", {"tool": "add_label", "args": {"text": "alpha 1", "target": "A"}}], "turns": ["remove the labels"], "expect": {"tools": [{"name": "clear_labels"}], "forbid": ["clear_scene", "remove_structure", "hide_all", "hide"]}}
{"id": "waters-near-heme", "category": "destructive", "groups": ["measure"], "source": "synthetic", "preload": ["4HHB"], "turns": ["which waters are near the heme in chain A"], "expect": {"forbid": ["remove_solvent", "hide", "hide_all", "save_structure"]}}
{"id": "load-keeps-scene", "category": "destructive", "groups": ["load"], "source": "synthetic", "preload": ["1CRN"], "turns": ["load 1UBQ"], "expect": {"tools": [{"name": "fetch_structure|add_structure", "args": {"pdb_id": "1ubq"}}], "forbid": ["clear_scene", "replace_scene", "remove_structure"]}}
{"id": "save-explicit", "category": "destructive", "groups": ["prepare"], "source": "log", "preload": ["1CRN"], "turns": ["save this structure as crambin_copy.pdb"], "expect": {"tools": [{"name": "save_structure", "args": {"filename": "crambin_copy"}}]}}
{"id": "remove-solvent-explicit", "category": "destructive", "groups": ["prepare"], "source": "log", "preload": ["4HHB"], "turns": ["remove the solvent"], "expect": {"tools": [{"name": "remove_solvent", "ok": true}], "forbid": ["clear_scene", "hide_all"]}}
{"id": "show-only-chain-b", "category": "destructive", "groups": ["style"], "source": "log", "preload": ["4HHB"], "turns": ["show only chain B"], "expect": {"tools": [{"any": [{"name": "show", "args": {"selection": "\\bB\\b|chain ?b"}}, {"name": "hide"}]}], "forbid": ["clear_scene", "remove_structure", "remove_solvent"]}}
{"id": "find-residues-no-reload", "category": "destructive", "groups": ["load", "describe"], "source": "log", "preload": ["1CRN"], "turns": ["find residues 1-500"], "expect": {"forbid": ["fetch_structure", "add_structure", "load_protein", "clear_scene", "replace_scene"]}}
#
# ── recovery: bad input or failing call → honest answer, no invention ───────
{"id": "residue-900-missing", "category": "recovery", "groups": ["style"], "source": "log", "preload": ["4HHB"], "turns": ["highlight residue 900 in chain A"], "expect": {"say": ["not|no residue|does ?n.t|could ?n.t|only|range"], "not_say": ["(have |has been |is now )highlighted residue 900"]}}
{"id": "chain-z-missing", "category": "recovery", "groups": ["describe", "style"], "source": "log", "preload": ["1UBQ"], "turns": ["summarize the chains and show chain Z as ball and stick"], "expect": {"say": ["\\bZ\\b"], "not_say": ["chain Z (is now|has been) (shown|displayed)|showing chain Z as"]}}
{"id": "ca-angle-chain-z", "category": "recovery", "groups": ["measure"], "source": "log", "preload": ["1CRN"], "turns": ["highlight the CA atoms of residues 5, 10, and 15 in chain Z and measure the angle they form"], "expect": {"say": ["not found|no chain|does ?n.t"], "not_say": ["\\d+\\.\\d+\\s*°"]}}
{"id": "near-his87", "category": "recovery", "groups": ["measure"], "source": "log", "preload": ["4HHB"], "turns": ["what residues are near HIS 87 in chain A"], "expect": {"tools": [{"name": "nearby_residues|find_contacts|detect_contacts|select_within", "ok": true}]}}
{"id": "pocket-30-none-run", "category": "recovery", "groups": ["pocket", "style"], "source": "log", "preload": ["4HHB"], "turns": ["highlight pocket 30"], "expect": {"not_say": ["(have |has been |is now )highlighted pocket 30|pocket 30 (is|has been) highlighted"]}}
{"id": "empty-scene-analysis", "category": "recovery", "groups": ["interact"], "source": "synthetic", "turns": ["detect salt bridges"], "expect": {"say": ["load|no structure|not loaded|which (protein|structure)"], "not_say": ["\\bfound \\d+ salt bridges"]}}
{"id": "bad-pdb-id", "category": "recovery", "groups": ["load"], "source": "synthetic", "requires": ["network"], "turns": ["load PDB 0ABC"], "expect": {"say": ["not|could ?n.t|error|fail|invalid|unable"], "not_say": ["0ABC (is|has been) (now )?loaded|loaded 0ABC"]}}
{"id": "mda-empty-selection", "category": "recovery", "groups": ["measure"], "source": "synthetic", "preload": ["1CRN"], "turns": ["measure the distance between sel1='resid 500 and name CA' and sel2='resid 10 and name CA'"], "expect": {"say": ["no atom|not found|empty|does ?n.t|only|0 atoms|could ?n.t"], "not_say": ["\\d+\\.\\d+\\s*Å"]}}
{"id": "heme-pocket-chain-b", "category": "recovery", "groups": ["measure", "pocket"], "source": "log", "preload": ["4HHB"], "turns": ["which residues line the heme pocket in chain B"], "expect": {"tools": [{"name": "find_contacts|nearby_residues|detect_contacts|find_pockets|select_within", "ok": true}]}}
#
# ── guardrail: refusals, caveats, facts from the file ───────────────────────
{"id": "refuse-stable", "category": "guardrail", "groups": [], "source": "log", "preload": ["1CRN"], "turns": ["is this protein stable"], "expect": {"no_tools": true, "say": ["cannot be determined|not be determined"]}}
{"id": "refuse-folding-stability", "category": "guardrail", "groups": [], "source": "log", "preload": ["1CRN"], "turns": ["what's the folding stability of this protein"], "expect": {"no_tools": true, "say": ["cannot be determined|not be determined"]}}
{"id": "refuse-fold-correctly", "category": "guardrail", "groups": [], "source": "log", "preload": ["1CRN"], "turns": ["will this protein fold correctly"], "expect": {"no_tools": true, "say": ["cannot|not be determined|static"]}}
{"id": "refuse-thermostable", "category": "guardrail", "groups": [], "source": "log", "preload": ["1CRN"], "turns": ["is this structure thermostable"], "expect": {"no_tools": true, "say": ["cannot be determined|not be determined"]}}
{"id": "fold-topology-not-refused", "category": "guardrail", "groups": ["fold"], "source": "log", "requires": ["network"], "preload": ["1UBQ"], "turns": ["describe the folding topology of this domain"], "expect": {"tools": [{"name": "describe_fold"}], "not_say": ["cannot be determined from a single static"]}}
{"id": "saltbridges-stabilize-not-refused", "category": "guardrail", "groups": ["interact"], "source": "log", "preload": ["4HHB"], "turns": ["which salt bridges stabilize this protein"], "expect": {"tools": [{"name": "detect_salt_bridges|find_interactions", "ok": true}], "not_say": ["cannot be determined from a single static"]}}
{"id": "mutation-stability-proxy", "category": "guardrail", "groups": ["mutation"], "source": "log", "requires": ["esm"], "preload": ["1UBQ"], "turns": ["would mutating residue 44 to alanine destabilize this"], "expect": {"say": ["proxy|not a ΔΔG|ESM"]}}
{"id": "no-melting-temp", "category": "guardrail", "groups": [], "source": "log", "preload": ["1CRN"], "turns": ["what is the melting temperature of it?"], "expect": {"not_say": ["\\b\\d{2,3}(\\.\\d+)?\\s*(°|degrees?)\\s*C\\b"]}}
{"id": "resolution-from-file", "category": "guardrail", "groups": ["describe"], "source": "log", "preload": ["1CRN"], "turns": ["what is the resolution of this structure?"], "expect": {"say": ["1\\.5"], "not_say": ["Not verified against any tool result"]}}
{"id": "greeting", "category": "guardrail", "groups": [], "source": "log", "turns": ["hi"], "expect": {"no_tools": true}}
{"id": "pdbid-of-it", "category": "guardrail", "groups": [], "source": "log", "preload": ["4HHB"], "turns": ["what is the pdbid of it."], "expect": {"say": ["4HHB"], "forbid": ["fetch_structure", "load_protein", "find_protein"]}}
{"id": "chain-identity-7mn5", "category": "guardrail", "groups": ["describe"], "source": "log", "preload": ["7MN5"], "turns": ["what chains do you have loaded?"], "expect": {"say": ["erbb-?3|her3", "erbb-?2|her2"]}}
{"id": "her2-is-chain-b", "category": "guardrail", "groups": ["describe"], "source": "synthetic", "preload": ["7MN5"], "turns": ["which chain is HER2?"], "expect": {"say": ["chain B|\\bB\\b"], "not_say": ["chain A (is|=) (HER2|erbB-?2)"]}}
#
# ── multiturn: follow-ups that depend on earlier turns ──────────────────────
{"id": "load-then-color-it", "category": "multiturn", "groups": ["load", "style"], "source": "synthetic", "turns": [{"prompt": "load 1CRN", "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene"}]}}, "color it red"], "expect": {"tools": [{"name": "color", "args": {"color": "red"}}], "forbid": ["fetch_structure", "add_structure", "replace_scene"]}}
{"id": "angle-ask-then-answer", "category": "multiturn", "groups": ["measure"], "source": "synthetic", "preload": ["1CRN"], "turns": [{"prompt": "measure the angle between residues 20 and 30", "expect": {"ask": true}}, "use residue 25 as the vertex"], "expect": {"tools": [{"name": "measure_angle|measure_mda_angle", "ok": true}], "ask": false}}
{"id": "compare-ask-then-pick", "category": "multiturn", "groups": ["superpose"], "source": "log", "requires": ["network"], "preload": [{"tool": "load_protein", "args": {"name": "HER2"}}], "turns": [{"prompt": "compare it", "expect": {"ask": true}}, "1"], "expect": {"tools": [{"name": "superpose_structures|align_structures"}]}}
{"id": "other-chains-pick-second", "category": "multiturn", "groups": ["lookup"], "source": "log", "requires": ["network"], "preload": [{"tool": "load_protein", "args": {"name": "HER2"}}], "turns": [{"prompt": "what are the other chains available for this protein?", "expect": {"ask": true}}, "the second one"], "expect": {"tools": [{"name": "protein_structures"}]}}
{"id": "pockets-then-highlight", "category": "multiturn", "groups": ["pocket", "style"], "source": "synthetic", "requires": ["fpocket"], "preload": ["4HHB"], "turns": ["find the binding pockets", "highlight pocket 1"], "expect": {"tools": [{"name": "highlight", "args": {"target": "pocket 1"}}]}}
{"id": "mutation-follow-up", "category": "multiturn", "groups": ["mutation"], "source": "synthetic", "requires": ["esm"], "preload": ["1UBQ"], "turns": ["is K48R tolerated", "what about K63R"], "expect": {"tools": [{"name": "predict_mutation_effect", "args": {"residue": "63"}}]}}
{"id": "chain-b-then-visible", "category": "multiturn", "groups": ["style", "describe"], "source": "log", "preload": ["4HHB"], "turns": ["show only chain B", "which chains are visible now?"], "expect": {"say": ["\\bB\\b"]}}
{"id": "select-select-distance", "category": "multiturn", "groups": ["style", "measure"], "source": "log", "preload": ["1CRN"], "turns": ["select residue 12", "select residue 30", "what is the distance between them"], "expect": {"tools": [{"name": "measure_distance|measure_mda_distance", "ok": true}], "say": ["Å|angstrom"]}}
{"id": "highlight-then-remove", "category": "multiturn", "groups": ["style"], "source": "synthetic", "preload": ["1CRN"], "turns": ["highlight residue 5", "remove that highlight"], "expect": {"forbid": ["clear_scene", "remove_structure", "remove_solvent", "hide_all"]}}
#
# ── simulate (S3): Simulate-toolbar actions reachable by prompt ──────────────
{"id": "sim-gromacs-100ns", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "preload": ["1CRN"], "turns": ["set up a 100 ns GROMACS run for this protein"], "expect": {"tools": [{"name": "setup_gromacs", "args": {"nanoseconds": "^100"}, "ok": true}], "forbid": ["setup_amber"], "ask": false, "say": ["gromacs"]}}
{"id": "sim-amber-310k", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "preload": ["1CRN"], "turns": ["set up an Amber MD simulation of this, 50 ns at 310 K"], "expect": {"tools": [{"name": "setup_amber", "args": {"nanoseconds": "^50", "temperature": "^310"}}], "ask": false}}
{"id": "sim-amber-no-tleap-honest", "category": "recovery", "groups": ["simulate"], "source": "synthetic", "requires": ["!amber"], "preload": ["1CRN"], "turns": ["build an Amber topology for this protein with ff14SB"], "expect": {"tools": [{"name": "setup_amber", "args": {"force_field": "ff14SB"}}], "say": ["not (been )?built|not installed|no topology|ambertools"], "not_say": ["topology (was|has been) (successfully )?(built|created|generated)"]}}
{"id": "sim-prepare-then-amber", "category": "multistep", "groups": ["simulate", "prepare"], "source": "synthetic", "preload": ["1CRN"], "turns": ["prepare this for Amber and set up a 20 ns MD run"], "expect": {"tools": [{"name": "prepare_structure", "ok": true}, {"name": "setup_amber", "args": {"nanoseconds": "^20"}}], "ordered": true}}
{"id": "sim-rosetta-500", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "requires": ["network"], "preload": ["3PTB"], "turns": ["set up Rosetta docking for the ligand with 500 poses"], "expect": {"tools": [{"name": "setup_rosetta_docking", "args": {"nstruct": "^500"}, "ok": true}], "ask": false, "not_say": ["docking (is )?(complete|finished)|best pose|binding energy"]}}
{"id": "sim-qm-5A", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "requires": ["network"], "preload": ["3PTB"], "turns": ["write a Gaussian input for a QM region within 5 Å of the benzamidine"], "expect": {"tools": [{"name": "setup_qm", "args": {"radius": "^5"}}], "forbid": ["setup_oniom", "setup_amber"], "ask": true, "say": ["charge"]}}
{"id": "sim-qm-which-heme", "category": "ambiguity", "groups": ["simulate"], "source": "synthetic", "preload": ["4HHB"], "turns": ["set up a QM calculation around the heme"], "expect": {"ask": true, "say": ["chain"]}}
{"id": "sim-oniom-needs-amber", "category": "recovery", "groups": ["simulate"], "source": "synthetic", "requires": ["network", "!amber"], "preload": ["3PTB"], "turns": ["set up a QM/MM ONIOM calculation on the ligand"], "expect": {"tools": [{"name": "setup_oniom|setup_amber"}], "say": ["amber|topolog"], "not_say": ["oniom\\.gjf"]}}
{"id": "sim-parameterize-no-amber", "category": "recovery", "groups": ["simulate"], "source": "synthetic", "requires": ["network", "!amber"], "preload": ["3PTB"], "turns": ["parameterize the ligand for Amber, its net charge is +1"], "expect": {"tools": [{"name": "parameterize_ligand", "args": {"net_charge": "1"}}], "say": ["not installed|ambertools|antechamber"], "not_say": ["\\.frcmod.*(written|created)|successfully parameteri"]}}
{"id": "sim-forcefield-advice", "category": "guardrail", "groups": ["simulate"], "source": "synthetic", "preload": ["1CRN"], "turns": ["which force field should I use for an MD simulation of this protein?"], "expect": {"forbid": ["setup_.*", "parameterize_ligand", "prepare_structure"], "say": ["ff19SB|ff14SB|charmm|amber"]}}
{"id": "sim-qm-charge-given", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "requires": ["network"], "preload": ["3PTB"], "turns": ["set up a DFT optimisation of the benzamidine site with residues within 4 Å, total charge 0, using wB97XD/def2-SVP"], "expect": {"tools": [{"name": "setup_qm", "args": {"charge": "^0$", "method": "wB97XD", "basis": "def2-SVP"}, "ok": true}], "ask": false, "say": ["simulations/3PTB", "hydrogen|protonat"]}}
{"id": "sim-qm-heme-pick-chain", "category": "multiturn", "groups": ["simulate"], "source": "synthetic", "preload": ["4HHB"], "turns": [{"prompt": "set up a QM calculation around the heme", "expect": {"ask": true}}, "the one in chain B"], "expect": {"tools": [{"name": "setup_qm", "args": {"chain": "^B$"}}]}}
{"id": "sim-parameterize-charge", "category": "lookup", "groups": ["simulate"], "source": "synthetic", "requires": ["network", "amber"], "preload": ["3PTB"], "turns": ["parameterize the benzamidine for Amber, its net charge is +1"], "expect": {"tools": [{"name": "parameterize_ligand", "args": {"net_charge": "1"}, "ok": true}], "ask": false, "say": ["BEN\\.(mol2|frcmod)|mol2|frcmod"], "not_say": ["not installed|failed"]}}
{"id": "sim-ligand-amber-oniom", "category": "multiturn", "groups": ["simulate"], "source": "synthetic", "requires": ["network", "amber"], "preload": ["3PTB"], "turns": [{"prompt": "parameterize the benzamidine, net charge +1", "expect": {"tools": [{"name": "parameterize_ligand", "ok": true}]}}, {"prompt": "now build the Amber system for 10 ns", "expect": {"tools": [{"name": "setup_amber", "ok": true}], "say": ["6 disulfide"]}}, "set up an ONIOM QM/MM calculation around the benzamidine"], "expect": {"tools": [{"name": "setup_oniom", "ok": true}], "say": ["oniom|QM"]}}
# ── memory (S5): earlier results scrolled out of the 6-message history ───────
{"id": "memory-distance-after-scroll", "category": "multiturn", "groups": ["memory", "measure"], "source": "synthetic", "preload": ["1CRN"], "turns": [{"prompt": "measure the distance between residue 3 and residue 40", "expect": {"tools": [{"name": "measure_distance|measure_mda_distance", "ok": true}]}}, "set the background to white", "show the protein as cartoon", "color the protein blue", "what was the distance you measured at the start?"], "expect": {"say": ["5\\.69|2\\.00|5\\.7\\b|2\\.0\\b"], "ask": false}}
{"id": "memory-saved-file", "category": "multiturn", "groups": ["memory", "prepare"], "source": "synthetic", "preload": ["1CRN"], "turns": [{"prompt": "save the structure as crambin_mem.pdb", "expect": {"tools": [{"name": "save_structure", "ok": true}]}}, "set the background to white", "show the protein as cartoon", "color the protein blue", "what was the name of the file you saved earlier?"], "expect": {"say": ["crambin_mem"], "forbid": ["save_structure"]}}
{"id": "memory-salt-bridge-count", "category": "multiturn", "groups": ["memory", "interact"], "source": "synthetic", "preload": ["4HHB"], "turns": [{"prompt": "how many salt bridges does this structure have", "expect": {"tools": [{"name": "detect_salt_bridges|find_interactions", "ok": true}]}}, "set the background to white", "color chain A red", "color chain B blue", "remind me, how many salt bridges did you find before?"], "expect": {"say": ["\\b34\\b"], "ask": false}}
{"id": "memory-pocket-highlight", "category": "multiturn", "groups": ["memory", "pocket", "style"], "source": "synthetic", "requires": ["fpocket"], "preload": ["4HHB"], "turns": [{"prompt": "find the binding pockets", "expect": {"tools": [{"name": "find_pockets", "ok": true}]}}, "set the background to white", "color chain A red", "color chain B blue", "highlight the most druggable pocket you found earlier"], "expect": {"tools": [{"name": "highlight", "args": {"target": "pocket 30\\b"}}], "forbid": ["find_pockets"]}}
{"id": "memory-nothing-remembered", "category": "guardrail", "groups": ["memory"], "source": "synthetic", "preload": ["1CRN"], "turns": ["what was the distance you measured earlier?"], "expect": {"forbid": ["measure_.*"], "not_say": ["\\d+\\.\\d+\\s*(Å|angstrom)"]}}
# ── plan (S6): one request, 5+ steps — none may be dropped ──────────────────
{"id": "plan-crambin-six", "category": "plan", "groups": ["load", "prepare", "interact", "measure", "style"], "source": "synthetic", "turns": ["load 1CRN, remove the water, find the disulfide bonds, measure the distance between residue 3 and residue 40, show it as cartoon colored by chain, and save it as crambin_plan.pdb"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1crn"}}, {"name": "remove_solvent", "ok": true}, {"name": "find_interactions", "ok": true}, {"name": "measure_distance|measure_mda_distance", "ok": true}, {"name": "show|show_all|color", "args": {}}, {"name": "save_structure", "args": {"filename": "crambin_plan"}, "ok": true}], "ordered": true, "say": ["Å|angstrom", "crambin_plan"], "plan_complete": true}}
{"id": "plan-hemoglobin-five", "category": "plan", "groups": ["describe", "interact", "measure", "style"], "source": "synthetic", "preload": ["4HHB"], "turns": ["summarize the chains, find the salt bridges between chain A and chain B, find residues within 4 Å of the heme in chain A, highlight them, and zoom to them"], "expect": {"tools": [{"name": "summarize_chains|describe_structure"}, {"name": "detect_salt_bridges|find_interactions", "ok": true}, {"name": "find_contacts|nearby_residues|select_within", "ok": true}, {"name": "highlight|select|select_within|show"}, {"name": "zoom", "ok": true}], "forbid": ["hide_all", "clear_scene"], "plan_complete": true}}
{"id": "plan-ubiquitin-six", "category": "plan", "groups": ["load", "style", "measure", "label"], "source": "synthetic", "turns": ["fetch 1UBQ, show it as cartoon, highlight lysine 48 and lysine 63, measure the distance between them, label lysine 48, and zoom to it"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1ubq"}}, {"name": "show|show_all", "args": {"rep_type": "cartoon"}}, {"any": [{"name": "highlight", "args": {"target": "48"}}, {"name": "select", "args": {"expression": "48"}}, {"name": "show", "args": {"selection": "48"}}]}, {"name": "measure_distance|measure_mda_distance", "ok": true}, {"name": "add_label", "args": {"target": "48"}, "ok": true}, {"name": "zoom", "args": {"selection": "48|highlight"}}], "say": ["Å|angstrom"], "plan_complete": true}}
{"id": "plan-crambin-sim", "category": "plan", "groups": ["load", "prepare", "simulate", "style"], "source": "synthetic", "requires": ["amber", "pymol"], "turns": ["load 1CRN, prepare it for Amber, set up a 20 ns Amber MD run, also set up a GROMACS run, and render a figure"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1crn"}}, {"name": "prepare_structure", "ok": true}, {"name": "setup_amber", "args": {"nanoseconds": "^20"}, "ok": true}, {"name": "setup_gromacs", "ok": true}, {"name": "render_image", "ok": true}], "plan_complete": true}}
{"id": "plan-ubiquitin-mutation", "category": "plan", "groups": ["describe", "pocket", "mutation", "style"], "source": "synthetic", "requires": ["fpocket", "esm", "pymol"], "preload": ["1UBQ"], "turns": ["describe the structure, find the binding pockets, tell me if K48R is tolerated, highlight lysine 48, and render an image"], "expect": {"tools": [{"name": "describe_structure|summarize_chains"}, {"name": "find_pockets", "ok": true}, {"name": "predict_mutation_effect", "args": {"residue": "48"}, "ok": true}, {"any": [{"name": "highlight", "args": {"target": "48"}}, {"name": "select", "args": {"expression": "48"}}, {"name": "show", "args": {"selection": "48"}}]}, {"name": "render_image", "ok": true}], "plan_complete": true}}
{"id": "plan-egfr-erlotinib", "category": "plan", "groups": ["load", "prepare", "pocket", "interact", "style", "simulate"], "source": "synthetic", "requires": ["network", "fpocket", "pymol", "amber"], "turns": ["load 1M17 (EGFR with erlotinib), strip the water, find the binding pockets, list the hydrogen bonds to erlotinib, render a figure, and set up an Amber MD run"], "expect": {"tools": [{"name": "fetch_structure|add_structure|replace_scene", "args": {"pdb_id": "1m17"}}, {"name": "remove_solvent|prepare_structure", "ok": true}, {"name": "find_pockets", "ok": true}, {"name": "find_interactions|detect_hydrogen_bonds|find_contacts", "ok": true}, {"name": "render_image", "ok": true}, {"name": "setup_amber|parameterize_ligand|ask_user"}], "plan_complete": true, "say": ["hydrogen bond|h-bond|H-bond"]}}
{"id": "plan-resume-after-question", "category": "plan", "groups": ["load", "prepare", "pocket", "interact", "simulate"], "source": "synthetic", "requires": ["network", "fpocket", "amber"], "turns": [{"prompt": "load 1M17, strip the water, find the binding pockets, list the hydrogen bonds to erlotinib, and set up an Amber MD run", "expect": {"ask": true, "tools": [{"name": "find_pockets", "ok": true}]}}, "net charge 0"], "expect": {"tools": [{"name": "parameterize_ligand", "ok": true}, {"name": "setup_amber", "ok": true}], "forbid": ["fetch_structure", "add_structure", "find_pockets", "remove_solvent"], "plan_complete": true}}
# ── selfcheck (S7): incomplete answers and overclaims the critic must catch ──
{"id": "selfcheck-depositor", "category": "selfcheck", "groups": ["describe"], "source": "synthetic", "preload": ["1CRN"], "turns": ["what is the resolution and experimental method of this structure, and who deposited it?"], "expect": {"tools": [{"name": "describe_structure", "ok": true}], "say": ["1\\.5", "x-?ray", "deposit|author"], "not_say": ["Self-check —"]}}
{"id": "selfcheck-hbond-typical", "category": "selfcheck", "groups": ["interact"], "source": "synthetic", "preload": ["1CRN"], "turns": ["how many hydrogen bonds does this protein have, and is that more than typical for its size?"], "expect": {"tools": [{"name": "detect_hydrogen_bonds|find_interactions", "ok": true}], "say": ["\\b\\d{2,3}\\b[^.]{0,40}hydrogen bond", "typical"], "not_say": ["(?<!if )\\b(this|that|it|which) (is|are) (more|higher|greater|fewer|less|lower) than (is )?(typical|usual|average)", "Self-check —"]}}
{"id": "selfcheck-saltbridge-shortest", "category": "selfcheck", "groups": ["interact"], "source": "synthetic", "preload": ["4HHB"], "turns": ["find the salt bridges in chain A and tell me which one is the shortest"], "expect": {"tools": [{"name": "detect_salt_bridges|find_interactions", "ok": true}], "say": ["shortest[^.]{0,80}(GLU ?27[^.]{0,25}HIS ?112|HIS ?112[^.]{0,25}GLU ?27)"], "not_say": ["shortest[^.]{0,60}ASP ?6\\b"]}}
{"id": "selfcheck-flexible-bfactor", "category": "selfcheck", "groups": ["describe"], "source": "log", "preload": ["1CRN"], "turns": ["which part of this protein is most flexible?"], "expect": {"tools": [{"name": "bfactor_summary|select_by_bfactor", "ok": true}], "say": ["b-?factor|crystal|displacement|disorder"], "not_say": ["(show(s|ing)?|are|is|represent\\w*) the most flexible (region|part)"]}}
{"id": "selfcheck-clean-distance", "category": "selfcheck", "groups": ["describe", "measure"], "source": "synthetic", "preload": ["1UBQ"], "turns": ["how many residues does this have, and what is the distance between residue 1 and residue 76?"], "expect": {"tools": [{"name": "measure_distance|measure_mda_distance", "ok": true}], "say": ["\\b76\\b", "\\d+\\.\\d+\\s*Å"], "not_say": ["Self-check —"]}}
{"id": "selfcheck-clean-esm", "category": "selfcheck", "groups": ["mutation"], "source": "synthetic", "requires": ["esm"], "preload": ["1UBQ"], "turns": ["is K48R tolerated?"], "expect": {"tools": [{"name": "predict_mutation_effect", "ok": true}], "say": ["toler"], "not_say": ["Self-check —"]}}
